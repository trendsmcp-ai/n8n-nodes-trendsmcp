{
	"name": "n8n-nodes-trendsmcp",
	"version": "0.1.0",
	"description": "n8n community node for TrendsMCP. Query behavioral trend data across Google, YouTube, TikTok, Reddit, Amazon, Wikipedia, npm, Steam and more. One API key, three operations: time series, growth, and live top trends.",
	"license": "MIT",
	"homepage": "https://trendsmcp.ai/docs",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"trendsmcp",
		"trends",
		"google-trends",
		"tiktok",
		"youtube",
		"reddit",
		"amazon",
		"market-research",
		"seo"
	],
	"author": {
		"name": "TrendsMCP",
		"email": "hello@trendsmcp.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/trendsmcp/n8n-nodes-trendsmcp.git"
	},
	"engines": {
		"node": ">=22.16"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TrendsMcpApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TrendsMcp/TrendsMcp.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.42.0",
		"eslint": "9.39.4",
		"n8n-workflow": "*",
		"prettier": "3.8.3",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
